
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sphinx: Compilar documentación HTML",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "sphinx",
        "-b",
        "html",
        "source",
        "_build/html"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
